{
  "name": "Rethread",
  "short_name": "Rethread",
  "description": "Buy and sell second-hand fashion, books and more.",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#16191c",
  "theme_color": "#16191c",
  "categories": ["shopping", "lifestyle"],
